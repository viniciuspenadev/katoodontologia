---
import { stats } from '../data/site';
---

<section class="faixa" id="numeros" aria-label="Kato em números">
  <div class="shell shell--wide faixa__panel">
    <ul class="faixa__list">
      {
        stats.map((stat) => (
          <li class="stat" data-reveal>
            <span class="stat__value" aria-hidden="true">
              <span>{stat.prefix}</span><span
                data-count={stat.value}
                data-count-decimals="0"
              >
                {stat.value}
              </span><span>{stat.suffix}</span>
            </span>
            <span class="stat__label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .faixa {
    position: relative;
    z-index: 6;
    padding-top: clamp(1.25rem, 2vw, 2rem);
    padding-bottom: 0;
    background: var(--paper-1);
    color: var(--text-hi);
  }

  .faixa__panel {
    position: relative;
    transform: translateY(50%);
    margin-bottom: 0;
    padding: 0.7rem;
    overflow: hidden;
    border: 1px solid rgb(111 211 220 / 0.18);
    border-radius: clamp(1.25rem, 2.2vw, 2rem);
    background:
      radial-gradient(circle at 0% 50%, rgb(23 162 174 / 0.12), transparent 30%),
      linear-gradient(110deg, #08171b, #0b2228 58%, #09191e);
    box-shadow: 0 1.15rem 3rem rgb(5 12 14 / 0.15);
  }

  .faixa__panel::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 1px rgb(255 255 255 / 0.065);
    pointer-events: none;
  }

  .faixa__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stat {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.65rem;
    min-width: 0;
    padding: 1rem 0.7rem;
    color: #eef5f6;
  }

  .stat:nth-child(odd)::after {
    content: '';
    position: absolute;
    inset: 0.85rem 0 0.85rem auto;
    width: 1px;
    background: rgb(182 191 195 / 0.14);
  }

  .stat:nth-child(-n + 2) {
    border-bottom: 1px solid rgb(182 191 195 / 0.12);
  }

  .stat__value {
    display: inline-flex;
    align-items: baseline;
    flex: none;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 1.35rem + 1.1vw, 2.25rem);
    font-weight: 380;
    font-variation-settings: 'opsz' 28;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--aqua-300);
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    min-width: 0;
    font-family: var(--font-label);
    font-size: clamp(0.65rem, 0.61rem + 0.18vw, 0.76rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(238 245 246 / 0.72);
  }

  @media (width >= 55rem) {
    .faixa__panel {
      margin-bottom: 0;
      padding: 0.8rem 1rem;
    }

    .faixa__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .stat {
      padding: 1.15rem 1rem;
    }

    .stat:nth-child(-n + 2) {
      border-bottom: 0;
    }

    .stat:not(:last-child)::after {
      content: '';
      position: absolute;
      inset: 0.65rem 0 0.65rem auto;
      width: 1px;
      background: linear-gradient(to bottom, transparent, rgb(182 191 195 / 0.2), transparent);
    }
  }

  @media (width < 26rem) {
    .stat {
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      text-align: center;
    }
  }

  @media (width < 55rem) {
    .faixa {
      padding-top: clamp(1.25rem, 5vw, 2rem);
    }

    .faixa__panel {
      transform: translateY(50%);
      margin-bottom: 0;
    }
  }
</style>
