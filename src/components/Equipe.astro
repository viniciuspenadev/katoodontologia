---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BandEdge from './BandEdge.astro';
import { equipe } from '../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/equipe/*.{jpg,jpeg,png}', {
  eager: true,
});

const photo = (slug: string) =>
  files[`../assets/equipe/${slug}.jpg`]?.default ??
  files[`../assets/equipe/${slug}.jpeg`]?.default ??
  files[`../assets/equipe/${slug}.png`]?.default;
---

<section class="section band equipe" id="equipe">
  <BandEdge flip />

  <div class="shell shell--wide equipe__head">
    <p class="eyebrow" data-reveal>A equipe</p>
    <h2 data-reveal>Equipe <span class="em">Kato.</span></h2>
  </div>
  <div class="car" data-carousel>
    <div class="car__viewport" data-viewport>
      <ul class="car__track" data-track>
        {
          equipe.map((p) => {
            const img = photo(p.slug);
            return (
              <li class="card" data-card>
                <article class="card__body">
                  {img && (
                    <Image
                      src={img}
                      alt={`Retrato de ${p.name}`}
                      width={720}
                      height={960}
                      widths={[360, 720]}
                      sizes="(width >= 62rem) 21rem, 70vw"
                      format="avif"
                      quality={72}
                      loading="lazy"
                    />
                  )}
                  <div class="card__frame">
                    <div class="card__meta">
                      <h3 class="card__name">{p.name}</h3>
                      <p class="card__role">{p.role}</p>
                      <span class="card__tap" aria-hidden="true" />
                    </div>
                  </div>
                  <div class="card__more">
                    <div class="card__more-in">
                      {p.focus && <p class="card__focus">{p.focus}</p>}
                      {p.cro && <p class="card__cro">{p.cro}</p>}
                    </div>
                  </div>
                </article>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="car__veil car__veil--l" aria-hidden="true"></div>
    <div class="car__veil car__veil--r" aria-hidden="true"></div>
  </div>
</section>

<style>
  .equipe {
    --card-open: 6rem;
    z-index: 2;
    padding-top: clamp(3.5rem, 6vw, 6rem);
    padding-bottom: max(
      calc(var(--edge-h) + var(--space-2xs)),
      calc(clamp(9rem, 13vw, 12rem) - var(--card-open))
    );
  }

  .equipe :global(.edge) {
    height: clamp(6rem, 9vw, 10rem);
    z-index: 1;
  }

  .equipe__head {
    position: relative;
    z-index: 3;
    margin-top: 0;
    margin-bottom: clamp(3.5rem, 5vw, 5rem);
  }

  .equipe__head h2 {
    margin-top: var(--space-m);
    font-size: clamp(3rem, 4.4vw, 4.6rem);
    line-height: 1;
  }

  @media (width < 42rem) {
    .equipe {
      padding-top: 3rem;
    }

    .equipe__head {
      margin-bottom: 2.75rem;
    }

    .equipe__head h2 {
      font-size: clamp(2.75rem, 11vw, 3.7rem);
    }
  }

  .car {
    position: relative;
  }

  .car__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: var(--gutter);
    padding-bottom: var(--card-open);
  }

  .car__viewport::-webkit-scrollbar {
    display: none;
  }

  .car[data-live] .car__viewport {
    overflow-x: hidden;
    scroll-snap-type: none;
    touch-action: pan-y;
    cursor: grab;
  }

  .car.is-dragging .car__viewport {
    cursor: grabbing;
    -webkit-user-select: none;
    user-select: none;
  }

  .car.is-dragging .card {
    pointer-events: none;
  }

  .car__track {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: start;
    gap: var(--space-m);
    width: max-content;
    will-change: transform;
  }

  .card {
    --card-w: clamp(14rem, 46vw, 21rem);
    position: relative;
    flex: none;
    width: var(--card-w);
    height: calc(var(--card-w) * 4 / 3);
    scroll-snap-align: center;
  }

  .card__body {
    position: absolute;
    inset: 0 0 auto 0;
    display: grid;
    grid-template-rows: auto 0fr;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: clamp(1.5rem, 2.5vw, 2.25rem);
    background: var(--surface-raised);
    transition:
      grid-template-rows var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .card:hover .card__body,
  .card:focus-within .card__body,
  .card.is-open .card__body {
    grid-template-rows: auto 1fr;
    border-color: var(--line-strong);
  }

  .card__body :global(img) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    filter: saturate(0.96) contrast(1.02);
    transition: filter var(--dur-slow) var(--ease-out);
  }

  .card:hover .card__body :global(img),
  .card:focus-within .card__body :global(img),
  .card.is-open .card__body :global(img) {
    filter: saturate(1.04) contrast(1.01);
  }

  .card__body::before,
  .card__body::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .card__body::after {
    background: linear-gradient(180deg, transparent 45%, rgb(5 12 14 / 0.85));
  }

  .card__body::before {
    background: linear-gradient(180deg, transparent 18%, rgb(5 12 14 / 0.92));
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .card:hover .card__body::before,
  .card:focus-within .card__body::before,
  .card.is-open .card__body::before {
    opacity: 1;
  }

  .card__frame {
    position: relative;
    z-index: 2;
    aspect-ratio: 3 / 4;
  }

  .card__meta {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-m);
    text-align: center;
  }

  .card__name {
    font-size: var(--step-2);
    font-weight: 400;
    color: var(--text-hi);
  }

  .card__role {
    margin-top: var(--space-3xs);
    font-family: var(--font-label);
    font-size: var(--step--1);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: rgb(238 245 246 / 0.66);
  }

  .card__more {
    position: relative;
    z-index: 2;
    min-height: 0;
    overflow: hidden;
  }

  .card__more-in {
    display: grid;
    justify-items: center;
    gap: var(--space-3xs);
    padding: 0 var(--space-s) var(--space-m);
    text-align: center;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .card__more-in::before {
    content: '';
    width: 2rem;
    height: 1px;
    margin-bottom: var(--space-2xs);
    background: var(--grad-swoosh);
  }

  .card:hover .card__more-in,
  .card:focus-within .card__more-in,
  .card.is-open .card__more-in {
    opacity: 1;
    transform: none;
  }

  .card__focus {
    font-family: var(--font-label);
    font-size: var(--step--1);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--accent-bright);
  }

  .card__cro {
    font-size: var(--step--1);
    color: var(--text-mid);
  }

  .card__tap {
    display: none;
  }

  @media (hover: none) {
    .card__tap {
      display: block;
      position: relative;
      width: 0.85rem;
      height: 0.85rem;
      margin: var(--space-xs) auto 0;
      opacity: 0.75;
      transition:
        transform var(--dur-base) var(--ease-out),
        opacity var(--dur-base) var(--ease-out);
    }

    .card__tap::before,
    .card__tap::after {
      content: '';
      position: absolute;
      inset: 50% 0 auto 0;
      height: 1px;
      background: var(--accent-bright);
    }

    .card__tap::after {
      transform: rotate(90deg);
    }

    .card.is-open .card__tap {
      transform: rotate(45deg);
      opacity: 1;
    }

    .card__more-in::before {
      display: none;
    }

    .car:not([data-live]) .card__tap {
      display: none;
    }

    .car:not([data-live]) .card__body {
      grid-template-rows: auto 1fr;
    }

    .car:not([data-live]) .card__body::before {
      opacity: 1;
    }

    .car:not([data-live]) .card__more-in {
      opacity: 1;
      transform: none;
    }
  }

  .car__veil {
    position: absolute;
    inset-block: 0 var(--card-open);
    width: clamp(3.5rem, 14vw, 14rem);
    z-index: 2;
    pointer-events: none;
    backdrop-filter: blur(12px) saturate(0.85);
    -webkit-backdrop-filter: blur(12px) saturate(0.85);
  }

  .car__veil--l {
    inset-inline-start: 0;
    background: linear-gradient(
      to right,
      var(--surface) 0%,
      rgb(5 12 14 / 0.72) 38%,
      transparent 100%
    );
    mask-image: linear-gradient(to right, #000 0%, #000 18%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, #000 0%, #000 18%, transparent 100%);
  }

  .car__veil--r {
    inset-inline-end: 0;
    background: linear-gradient(
      to left,
      var(--surface) 0%,
      rgb(5 12 14 / 0.72) 38%,
      transparent 100%
    );
    mask-image: linear-gradient(to left, #000 0%, #000 18%, transparent 100%);
    -webkit-mask-image: linear-gradient(to left, #000 0%, #000 18%, transparent 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .card__body :global(img) {
      transition: none;
    }
  }
</style>
