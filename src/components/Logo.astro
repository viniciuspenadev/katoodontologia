---
interface Props {
  /** A slightly smaller lockup for compact navigation areas. */
  compact?: boolean;
  /** Surface hint kept for subtle contrast treatment. */
  tone?: 'light' | 'dark';
}

const { compact = false, tone = 'light' } = Astro.props;
const logoSrc = tone === 'light' ? '/brand/kato-logo-light.svg' : '/brand/kato-logo.svg';
---

<span class:list={['logo', compact && 'logo--compact', `logo--${tone}`]}>
  <img
    src={logoSrc}
    alt="Kato Odontologia"
    width="1740"
    height="480"
    decoding="async"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    width: clamp(9.75rem, 11.25vw, 11rem);
    height: auto;
    line-height: 0;
  }

  .logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .logo--compact {
    width: clamp(9.1rem, 10.5vw, 10.4rem);
    height: auto;
  }

  .logo--light img {
    filter: drop-shadow(0 1px 8px rgb(0 0 0 / 0.12));
  }

  @media (width < 34rem) {
    .logo--compact {
      width: 8.25rem;
    }
  }
</style>
