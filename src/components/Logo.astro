---
interface Props {
  /** A slightly smaller lockup for compact navigation areas. */
  compact?: boolean;
  /** Surface hint kept for subtle contrast treatment. */
  tone?: 'light' | 'dark';
}

const { compact = false, tone = 'light' } = Astro.props;
const logoSrc = tone === 'light' ? '/brand/kato-logo-light.svg' : '/brand/kato-logo.svg';
---

<span class:list={['logo', compact && 'logo--compact', `logo--${tone}`]}>
  <img
    src={logoSrc}
    alt="Kato Odontologia"
    width="743"
    height="665"
    decoding="async"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    width: auto;
    height: clamp(4rem, 5vw, 4.75rem);
    line-height: 0;
  }

  .logo img {
    display: block;
    width: auto;
    height: 100%;
  }

  .logo--compact {
    width: auto;
    height: clamp(3rem, 3.5vw, 3.3rem);
  }

  .logo--light img {
    filter: drop-shadow(0 1px 8px rgb(0 0 0 / 0.12));
  }

  @media (width < 34rem) {
    .logo--compact {
      height: 2.85rem;
    }
  }
</style>
