---
import { Image } from 'astro:assets';
import { especialidades, primaryWhats } from '../data/site';
import { especialidadeFotos } from '../data/especialidades-fotos';

const itens = especialidades.map((especialidade, index) => ({
  ...especialidade,
  image: especialidadeFotos[index],
}));
---

<section class="section band band--light esp" id="especialidades">
  <div class="shell shell--wide">
    <header class="esp__head">
      <p class="eyebrow eyebrow--center" data-reveal>Especialidades</p>
      <h2 data-reveal>Seis frentes, <span class="em">um</span> diagnóstico.</h2>
      <p class="prose esp__prose" data-reveal>
        Cada necessidade é vista por inteiro. Escolha uma especialidade para
        conhecer a forma como cuidamos de cada etapa do tratamento.
      </p>
    </header>

    <div class="esp__experience" data-services data-reveal>
      <div class="esp__stage">
        <div class="esp__menu" role="tablist" aria-label="Especialidades odontológicas">
          {
            itens.map((item, index) => (
              <button
                class:list={['esp__tab', index === 0 && 'is-active']}
                id={`servico-tab-${index}`}
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`servico-panel-${index}`}
                tabindex={index === 0 ? '0' : '-1'}
                data-service-tab={index}
              >
                <span class="esp__number">{item.n}</span>
                <span class="esp__tab-copy">
                  <strong>{item.name}</strong>
                  <span>{item.body}</span>
                </span>
                <span class="esp__arrow" aria-hidden="true">↗</span>
              </button>
            ))
          }
        </div>

        <div class="esp__visuals">
          {
            itens.map((item, index) => (
              <article
                class:list={['esp__panel', index === 0 && 'is-active']}
                id={`servico-panel-${index}`}
                role="tabpanel"
                aria-labelledby={`servico-tab-${index}`}
                hidden={index !== 0}
                data-service-panel={index}
              >
                <Image
                  src={item.image}
                  alt={`Atendimento de ${item.name.toLowerCase()} na Kato Odontologia`}
                  widths={[720, 1080, 1536]}
                  sizes="(min-width: 62rem) 46rem, calc(100vw - 3rem)"
                  format="avif"
                  quality={82}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
                <div class="esp__caption">
                  <span>{item.n} · Especialidade</span>
                  <strong>{item.name}</strong>
                  <a href={primaryWhats} target="_blank" rel="noopener">
                    Conversar com a equipe <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .esp {
    overflow-x: clip;
    overflow-y: visible;
    padding-top: clamp(2.5rem, 4.5vw, 4.5rem);
    padding-bottom: 0;
  }

  .esp__head {
    display: grid;
    justify-items: center;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    text-align: center;
  }

  .esp__head h2 {
    margin-block: var(--space-m);
  }

  .esp__prose {
    max-width: 52ch;
  }

  .esp__experience {
    position: relative;
    z-index: 4;
    transform: translateY(clamp(4.5rem, 7vw, 7rem));
    padding: clamp(0.75rem, 1.5vw, 1.15rem);
    border: 1px solid rgb(188 245 232 / 0.8);
    border-radius: clamp(1.75rem, 3.2vw, 3rem);
    background:
      radial-gradient(circle at 5% 8%, rgb(207 248 238 / 0.96), transparent 30%),
      radial-gradient(circle at 96% 8%, rgb(99 223 202 / 0.95), transparent 34%),
      radial-gradient(circle at 86% 98%, rgb(41 177 186 / 0.82), transparent 40%),
      linear-gradient(125deg, #bdeee3 0%, #83dfcf 45%, #28aeb7 100%);
    box-shadow:
      0 2.25rem 5.5rem rgb(8 49 53 / 0.2),
      0 0 0 1px rgb(117 229 210 / 0.16);
  }

  .esp__experience::before {
    content: '';
    position: absolute;
    width: 11rem;
    aspect-ratio: 1;
    inset: -4rem -2rem auto auto;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    box-shadow: 0 0 0 1.6rem rgb(255 255 255 / 0.07);
    pointer-events: none;
  }

  .esp__stage {
    position: relative;
    display: grid;
    min-height: 38rem;
    overflow: hidden;
    border: 1px solid rgb(7 26 31 / 0.07);
    border-radius: clamp(1.25rem, 2.4vw, 2.25rem);
    background: rgb(249 251 248 / 0.96);
    box-shadow: 0 1.25rem 3rem rgb(8 49 53 / 0.12);
  }

  .esp__menu {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: center;
    padding: clamp(1.25rem, 3vw, 2.8rem);
    background: linear-gradient(90deg, #fbfcfa 75%, rgb(251 252 250 / 0));
  }

  .esp__tab {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 1.5rem;
    gap: 0.75rem;
    align-items: start;
    width: 100%;
    padding: 1rem 0.1rem;
    border: 0;
    border-bottom: 1px solid rgb(7 26 31 / 0.11);
    background: transparent;
    color: var(--ink-1);
    text-align: left;
    cursor: pointer;
  }

  .esp__tab:first-child {
    border-top: 1px solid rgb(7 26 31 / 0.11);
  }

  .esp__number {
    padding-top: 0.25rem;
    font-family: var(--font-label);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: rgb(7 26 31 / 0.38);
  }

  .esp__tab-copy {
    display: grid;
    gap: 0.25rem;
  }

  .esp__tab-copy strong {
    font-family: var(--font-text);
    font-size: clamp(1rem, 0.96rem + 0.22vw, 1.16rem);
    font-weight: 620;
    line-height: 1.2;
  }

  .esp__tab-copy > span {
    max-height: 0;
    overflow: hidden;
    font-size: 0.83rem;
    line-height: 1.48;
    color: rgb(7 26 31 / 0.62);
    opacity: 0;
    transform: translateY(-0.2rem);
    transition:
      max-height 420ms var(--ease-out),
      opacity 280ms var(--ease-out),
      transform 280ms var(--ease-out);
  }

  .esp__arrow {
    padding-top: 0.05rem;
    font-size: 1.15rem;
    color: rgb(7 26 31 / 0.34);
    transition: transform var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }

  .esp__tab:hover .esp__arrow,
  .esp__tab.is-active .esp__arrow {
    color: var(--teal-500);
    transform: rotate(45deg);
  }

  .esp__tab.is-active .esp__number,
  .esp__tab.is-active .esp__tab-copy strong {
    color: var(--teal-700);
  }

  .esp__tab.is-active .esp__tab-copy > span {
    max-height: 5rem;
    opacity: 1;
    transform: none;
  }

  .esp__visuals {
    position: relative;
    min-height: 29rem;
    background: #dce5e1;
  }

  .esp__panel {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #dce5e1;
  }

  .esp__panel[hidden] {
    display: block;
    visibility: hidden;
    opacity: 0;
  }

  .esp__panel.is-active {
    visibility: visible;
    opacity: 1;
    animation: service-in 520ms var(--ease-out) both;
  }

  .esp__panel :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.9) contrast(1.01);
    transform: scale(1.015);
  }

  .esp__panel::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(249 251 248 / 0.98) 0%, rgb(249 251 248 / 0.55) 12%, transparent 36%),
      linear-gradient(0deg, rgb(4 18 21 / 0.66), transparent 44%);
    pointer-events: none;
  }

  .esp__caption {
    position: absolute;
    z-index: 2;
    inset: auto clamp(1.25rem, 3vw, 2.5rem) clamp(1.25rem, 3vw, 2.25rem);
    display: grid;
    justify-items: start;
    color: #fff;
  }

  .esp__caption > span {
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }

  .esp__caption strong {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3vw, 3rem);
    font-weight: 380;
    line-height: 1.05;
  }

  .esp__caption a {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    margin-top: 0.9rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.5);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }

  .esp__caption a:hover {
    color: var(--aqua-300);
  }

  @keyframes service-in {
    from { opacity: 0; transform: scale(1.025); }
    to { opacity: 1; transform: none; }
  }

  @media (width >= 62rem) {
    .esp__stage {
      grid-template-columns: minmax(23rem, 0.78fr) minmax(0, 1.45fr);
    }

    .esp__visuals {
      min-height: 38rem;
    }

    .esp__menu {
      margin-right: -5rem;
      padding-right: 6rem;
    }

    .esp__caption {
      inset-inline-start: clamp(8rem, 11vw, 12rem);
    }
  }

  @media (width < 62rem) {
    .esp__stage {
      min-height: 0;
    }

    .esp__menu {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-content: initial;
      gap: 0.55rem;
      padding: 1rem;
      background: #fbfcfa;
    }

    .esp__tab {
      grid-template-columns: 1.65rem 1fr;
      align-content: start;
      min-height: 4.75rem;
      padding: 0.9rem;
      border: 1px solid rgb(7 26 31 / 0.09);
      border-radius: 1rem;
      background: #f4f7f4;
    }

    .esp__tab:first-child {
      border-top: 1px solid rgb(7 26 31 / 0.09);
    }

    .esp__tab.is-active {
      border-color: rgb(23 162 174 / 0.24);
      background: linear-gradient(135deg, #eaf5d5, #dff4ed);
      box-shadow: 0 0.5rem 1.4rem rgb(8 49 53 / 0.08);
    }

    .esp__tab-copy > span,
    .esp__arrow {
      display: none;
    }

    .esp__visuals {
      aspect-ratio: 4 / 3;
      min-height: 24rem;
    }

    .esp__panel::after {
      background: linear-gradient(0deg, rgb(4 18 21 / 0.74), transparent 54%);
    }

    .esp__caption {
      inset: auto 1.25rem 1.25rem;
    }

    .esp__caption strong {
      font-size: clamp(2rem, 5.5vw, 2.65rem);
    }

    .esp__caption a {
      min-height: 2.85rem;
      padding: 0.7rem 1rem;
      border: 1px solid rgb(255 255 255 / 0.32);
      border-radius: 999px;
      background: rgb(4 18 21 / 0.34);
      backdrop-filter: blur(10px);
    }
  }

  @media (width < 34rem) {
    .esp__experience {
      margin-inline: -0.35rem;
      border-radius: 1.65rem;
      transform: translateY(3.5rem);
    }

    .esp__stage {
      border-radius: 1.2rem;
    }

    .esp__menu {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 0.75rem;
    }

    .esp__tab {
      grid-template-columns: 1.35rem minmax(0, 1fr);
      min-height: 4.35rem;
      gap: 0.45rem;
      padding: 0.72rem;
      border-radius: 0.85rem;
    }

    .esp__number {
      font-size: 0.58rem;
    }

    .esp__tab-copy strong {
      font-size: 0.9rem;
      line-height: 1.15;
    }

    .esp__visuals {
      aspect-ratio: 3 / 4;
      min-height: 28rem;
    }

    .esp__panel :global(img) {
      object-position: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .esp__panel.is-active {
      animation: none;
    }
  }
</style>

<script>
  const groups = document.querySelectorAll<HTMLElement>('[data-services]');

  groups.forEach((group) => {
    const tabs = [...group.querySelectorAll<HTMLButtonElement>('[data-service-tab]')];
    const panels = [...group.querySelectorAll<HTMLElement>('[data-service-panel]')];

    const activate = (nextIndex: number, focus = false) => {
      tabs.forEach((tab, index) => {
        const active = index === nextIndex;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });

      panels.forEach((panel, index) => {
        const active = index === nextIndex;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();

        let next = index;
        if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
        else next = (index - 1 + tabs.length) % tabs.length;

        activate(next, true);
      });
    });
  });
</script>
