---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/equipe/renan-kato.jpg';
import { primaryWhats } from '../data/site';
---

<section class="hero" id="top">
  <div class="hero__card">
    <div class="hero__visual">
      <Image
        src={heroPhoto}
        alt="Dr. Renan Kato em uma das unidades da Kato Odontologia"
        width={1920}
        height={2880}
        widths={[720, 1080, 1440, 1920, 2560]}
        sizes="(min-width: 62rem) 60vw, 100vw"
        format="avif"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="shell shell--wide hero__content">
      <div class="hero__copy">
        <h1 class="hero__title" data-reveal data-reveal-lines>
          Seu sorriso muda.<br />
          Nosso cuidado <span>continua.</span>
        </h1>

        <p class="hero__description" data-reveal>
          Há mais de 30 anos, unimos experiência, cuidado próximo e uma equipe completa para
          cuidar da saúde bucal de famílias em Guarulhos.
        </p>

        <div class="hero__actions" data-reveal>
          <a class="hero__primary" href={primaryWhats} target="_blank" rel="noopener">
            Agendar consulta
            <span aria-hidden="true">→</span>
          </a>
          <a class="hero__secondary" href="#clinica">Conheça a Kato</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: sticky;
    top: 0;
    background: var(--paper-1);
  }

  .hero__card {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + 2.5rem) clamp(4.5rem, 9vh, 6.5rem);
    overflow: hidden;
    isolation: isolate;
    border-radius: 0 0 clamp(1.5rem, 3vw, 2.75rem) clamp(1.5rem, 3vw, 2.75rem);
    background:
      radial-gradient(circle at 12% 38%, rgb(190 245 246 / 0.42), transparent 31rem),
      linear-gradient(120deg, #ffffff 0%, var(--paper-1) 48%, var(--paper-2) 100%);
  }

  .hero__visual,
  .hero__shade {
    position: absolute;
    inset: 0;
  }

  .hero__visual {
    z-index: -2;
    left: 42%;
  }

  .hero__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    filter: saturate(0.96) contrast(1.01) brightness(1.02);
    transform: scale(1.006);
  }

  .hero__shade {
    z-index: -1;
    background:
      linear-gradient(180deg, transparent 68%, rgb(247 252 252 / 0.18) 100%),
      linear-gradient(
        90deg,
        #ffffff 0%,
        rgb(255 255 255 / 0.98) 35%,
        rgb(247 252 252 / 0.88) 44%,
        rgb(247 252 252 / 0.28) 57%,
        transparent 72%
      );
  }

  .hero__content {
    display: flex;
    align-items: center;
  }

  .hero__copy {
    width: min(100%, 41rem);
    min-width: 0;
  }

  .hero__title {
    max-width: 11.5ch;
    font-family: var(--font-text);
    font-size: clamp(3.45rem, 5.6vw, 5.65rem);
    font-weight: 540;
    font-variation-settings: normal;
    line-height: 0.92;
    letter-spacing: -0.058em;
    color: var(--ink-1);
    text-wrap: balance;
  }

  .hero__title span {
    font: inherit;
    letter-spacing: inherit;
    color: var(--teal-500);
  }

  .hero__description {
    max-width: 47ch;
    margin-top: clamp(1.5rem, 2.6vh, 2rem);
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.12rem);
    line-height: 1.62;
    color: rgb(16 45 48 / 0.74);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 3vh, 2rem);
  }

  .hero__primary,
  .hero__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 3.15rem;
    padding-inline: 1.4rem;
    border-radius: 999px;
    font-family: var(--font-text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease-out),
      background var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .hero__primary {
    background: var(--teal-500);
    color: var(--accent-ink);
    box-shadow: 0 0.8rem 2.4rem rgb(1 175 179 / 0.18);
  }

  .hero__primary:hover {
    background: var(--teal-600);
    color: #fff;
    transform: translateY(-2px);
  }

  .hero__secondary {
    border: 1px solid rgb(0 154 156 / 0.24);
    background: rgb(255 255 255 / 0.72);
    color: var(--ink-1);
    backdrop-filter: blur(8px);
  }

  .hero__secondary:hover {
    border-color: var(--teal-500);
    background: var(--aqua-100);
    color: var(--teal-800);
    transform: translateY(-2px);
  }

  @media (width < 62rem) {
    .hero__card {
      align-items: end;
      min-height: max(46rem, 100svh);
      padding-block: calc(var(--header-h) + 2.5rem) clamp(3.5rem, 7vh, 4.5rem);
    }

    .hero__visual {
      left: 0;
    }

    .hero__visual :global(img) {
      object-position: 50% 34%;
      filter: saturate(0.94) contrast(1.01) brightness(1.02);
    }

    .hero__shade {
      background:
        linear-gradient(180deg, transparent 0%, rgb(247 252 252 / 0.08) 34%, rgb(247 252 252 / 0.92) 65%, #f7fcfc 82%),
        linear-gradient(90deg, rgb(247 252 252 / 0.48), transparent 80%);
    }

    .hero__copy {
      width: min(100%, 37rem);
    }

    .hero__title {
      max-width: 11ch;
      font-size: clamp(2.9rem, 9.5vw, 4.45rem);
    }
  }

  @media (width < 34rem) {
    .hero__card {
      min-height: max(43rem, 100svh);
      border-radius: 0 0 1.4rem 1.4rem;
    }

    .hero__content {
      width: calc(100% - 2rem);
    }

    .hero__title {
      font-size: clamp(2.55rem, 12.2vw, 3.4rem);
    }

    .hero__description {
      max-width: 34ch;
      margin-top: 1.15rem;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .hero__actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: min(100%, 20rem);
      margin-top: 1.25rem;
    }

    .hero__primary,
    .hero__secondary {
      width: 100%;
      min-width: 0;
      min-height: 3rem;
      padding-inline: 0.8rem;
      font-size: 0.78rem;
    }
  }
</style>
