---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import footerSmile from '../assets/footer-sorriso.png';
import { primaryWhats, site, unidades } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="shell shell--wide">
    <section class="ftr__invite" aria-labelledby="footer-title">
      <Image
        class="ftr__invite-photo"
        src={footerSmile}
        alt="Sorriso natural"
        widths={[720, 1080, 1672]}
        sizes="(min-width: 55rem) 48vw, 100vw"
        format="avif"
        quality={84}
        loading="lazy"
      />
      <div class="ftr__invite-shade" aria-hidden="true"></div>
      <div class="ftr__invite-copy">
        <p class="ftr__eyebrow">O cuidado continua</p>
        <h2 id="footer-title">Vamos cuidar do seu <em>próximo sorriso?</em></h2>
      </div>
      <a class="ftr__cta" href={primaryWhats} target="_blank" rel="noopener">
        Agendar pelo WhatsApp
        <span aria-hidden="true">→</span>
      </a>
    </section>

    <div class="ftr__main">
      <div class="ftr__brand">
        <a href="#top" aria-label="Kato Odontologia — voltar ao início">
          <Logo compact />
        </a>
        <p>Kato, clínica odontológica em Guarulhos desde 1995.</p>
        <div class="ftr__social">
          <a href={site.social.instagram} target="_blank" rel="noopener">Instagram ↗</a>
          <a href={site.social.facebook} target="_blank" rel="noopener">Facebook ↗</a>
        </div>
      </div>

      <nav class="ftr__nav" aria-label="Navegação do rodapé">
        <p class="ftr__label">Explore</p>
        <ul>
          <li><a href="#clinica">A clínica</a></li>
          <li><a href="#especialidades">Especialidades</a></li>
          <li><a href="#equipe">Equipe Kato</a></li>
          <li><a href="#avaliacoes">Avaliações</a></li>
          <li><a href="#contato">Unidades</a></li>
        </ul>
      </nav>

      <div class="ftr__contact">
        <p class="ftr__label">Fale com a Kato</p>
        {
          unidades.map((unidade) => (
            <a class="ftr__unit" href={unidade.whatsappHref} target="_blank" rel="noopener">
              <span>{unidade.district}</span>
              <strong>{unidade.whatsapp}</strong>
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="ftr__bottom">
      <div class="ftr__legal">
        <p>Responsável técnico: {site.responsible.name} — {site.responsible.cro}</p>
        <p>© {year} {site.name}. Todos os direitos reservados.</p>
      </div>

      <div class="ftr__studio" aria-label="Site desenvolvido pela BlueDigital Hub">
        <span>Criação e desenvolvimento</span>
        <img
          src="/brand/logo_blue_cumprida-white.png"
          alt="BlueDigital Hub"
          width={220}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    z-index: 2;
    overflow: visible;
    padding-block: clamp(4.5rem, 7vw, 7rem) clamp(1.5rem, 3vw, 2.5rem);
    background:
      radial-gradient(circle at 12% 0%, rgb(43 184 196 / 0.11), transparent 30rem),
      linear-gradient(145deg, #061115 0%, var(--abyss) 58%, #07181d 100%);
    color: var(--text-mid);
  }

  .ftr__invite {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    align-items: flex-start;
    justify-content: center;
    min-height: clamp(24rem, 32vw, 30rem);
    margin-top: calc(-1 * clamp(7rem, 8vw, 10rem));
    padding: clamp(2.5rem, 5vw, 4.75rem);
    border-bottom: 1px solid rgb(182 191 195 / 0.16);
    border-radius: clamp(1.5rem, 3vw, 2.75rem);
    background: #061115;
    box-shadow: 0 2.5rem 5.5rem rgb(0 0 0 / 0.24);
  }

  .ftr__invite-photo,
  .ftr__invite-shade {
    position: absolute;
    inset: 0 0 0 auto;
    height: 100%;
  }

  .ftr__invite-photo {
    z-index: -2;
    width: 76%;
    object-fit: cover;
    object-position: right center;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.32) 14%, #000 40%);
    mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.32) 14%, #000 40%);
  }

  .ftr__invite-shade {
    z-index: -1;
    width: 100%;
    background:
      linear-gradient(90deg, #061115 0%, #061115 34%, rgb(6 17 21 / 0.9) 44%, rgb(6 17 21 / 0.24) 64%, transparent 82%),
      linear-gradient(0deg, rgb(6 17 21 / 0.2), transparent 55%);
  }

  .ftr__invite-copy {
    position: relative;
    z-index: 1;
    width: min(49%, 36rem);
  }

  .ftr__eyebrow,
  .ftr__label {
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 550;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--aqua-300);
  }

  .ftr__invite h2 {
    max-width: 13ch;
    margin-top: 0.9rem;
    font-size: clamp(2.6rem, 4.7vw, 5rem);
    font-weight: 360;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .ftr__invite h2 em {
    font-weight: inherit;
    color: var(--aqua-300);
  }

  .ftr__cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    min-height: 3.75rem;
    padding-inline: 1.6rem;
    border-radius: 999px;
    background: var(--teal-500);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.2);
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-base) var(--ease-out);
  }

  .ftr__cta:hover {
    background: var(--aqua-300);
    color: var(--ink-1);
    transform: translateY(-2px);
  }

  .ftr__main {
    display: grid;
    gap: 2.75rem;
    padding-block: clamp(3rem, 5vw, 4.75rem);
  }

  .ftr__brand > a {
    display: inline-flex;
  }

  .ftr__brand > p {
    max-width: 31ch;
    margin-top: 1.15rem;
    line-height: 1.6;
    color: rgb(238 245 246 / 0.62);
  }

  .ftr__social {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .ftr__social a,
  .ftr__nav a {
    font-size: 0.86rem;
    text-decoration: none;
    color: rgb(238 245 246 / 0.76);
  }

  .ftr__social a:hover,
  .ftr__nav a:hover {
    color: var(--aqua-300);
  }

  .ftr__nav ul {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    margin-top: 1.15rem;
    list-style: none;
  }

  .ftr__contact {
    min-width: 0;
  }

  .ftr__unit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 1rem;
    align-items: center;
    padding-block: 1rem;
    border-bottom: 1px solid rgb(182 191 195 / 0.13);
    text-decoration: none;
    color: rgb(238 245 246 / 0.72);
  }

  .ftr__unit:first-of-type {
    margin-top: 0.45rem;
  }

  .ftr__unit span:first-child {
    font-size: 0.84rem;
  }

  .ftr__unit strong {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-hi);
  }

  .ftr__unit span:last-child {
    color: var(--aqua-300);
  }

  .ftr__unit:hover {
    color: var(--aqua-300);
  }

  .ftr__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(182 191 195 / 0.16);
  }

  .ftr__legal {
    display: grid;
    gap: 0.25rem;
    font-size: 0.7rem;
    color: rgb(238 245 246 / 0.42);
  }

  .ftr__studio {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
  }

  .ftr__studio span {
    font-family: var(--font-label);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(238 245 246 / 0.4);
  }

  .ftr__studio :global(img) {
    width: clamp(7.25rem, 10vw, 9rem);
    height: auto;
    opacity: 0.9;
  }

  @media (width >= 55rem) {
    .ftr__main {
      grid-template-columns: minmax(0, 1.35fr) minmax(10rem, 0.55fr) minmax(18rem, 0.85fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .ftr__bottom {
      flex-direction: row;
      align-items: end;
      justify-content: space-between;
    }

    .ftr__studio {
      justify-content: flex-end;
    }
  }

  @media (width < 55rem) {
    .ftr__invite {
      min-height: 31rem;
      margin-top: calc(-1 * clamp(4.5rem, 9vw, 6rem));
    }

    .ftr__invite-photo {
      width: 100%;
      object-position: 68% center;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.2) 20%, #000 58%);
      mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.2) 20%, #000 58%);
    }

    .ftr__invite-copy {
      width: min(76%, 31rem);
    }

    .ftr__invite-shade {
      background:
        linear-gradient(90deg, #061115 0%, rgb(6 17 21 / 0.98) 38%, rgb(6 17 21 / 0.65) 66%, rgb(6 17 21 / 0.16) 100%),
        linear-gradient(0deg, rgb(6 17 21 / 0.28), transparent 58%);
    }
  }

  @media (width < 34rem) {
    .ftr {
      padding-top: 3.75rem;
    }

    .ftr__invite {
      min-height: 29rem;
      margin-top: -5rem;
      padding: 2rem 1.4rem;
    }

    .ftr__invite-photo {
      width: 100%;
      object-position: 68% center;
      -webkit-mask-image: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0.8) 42%, transparent 92%);
      mask-image: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0.8) 42%, transparent 92%);
    }

    .ftr__invite-shade {
      background:
        linear-gradient(180deg, #061115 0%, rgb(6 17 21 / 0.96) 44%, rgb(6 17 21 / 0.52) 72%, rgb(6 17 21 / 0.18) 100%),
        linear-gradient(90deg, rgb(6 17 21 / 0.75), transparent);
    }

    .ftr__invite h2 {
      font-size: clamp(2.5rem, 13vw, 3.5rem);
    }

    .ftr__invite-copy {
      width: 100%;
    }

    .ftr__cta {
      width: 100%;
    }

    .ftr__unit {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .ftr__unit span:last-child {
      display: none;
    }
  }
</style>
