---
import BandEdge from './BandEdge.astro';
import Icon from './Icon.astro';
import { unidades } from '../data/site';
import 'leaflet/dist/leaflet.css';

const mapLocations: Record<string, { lat: number; lng: number; short: string }> = {
  macedo: { lat: -23.4650979, lng: -46.5214928, short: 'Macedo' },
  'cidade-maia': { lat: -23.456445, lng: -46.5271537, short: 'Cidade Maia' },
};
---

<section class="section band unid" id="contato">
  <BandEdge flip />

  <div class="shell shell--wide">
    <header class="unid__head">
      <div>
        <p class="eyebrow" data-reveal>Onde estamos</p>
        <h2 data-reveal>Duas unidades.<br />Uma Kato <span class="em">perto de você.</span></h2>
      </div>
      <p class="unid__intro" data-reveal>
        Macedo e Cidade Maia estão a poucos minutos de distância. Explore o mapa e escolha a unidade mais conveniente para a sua rotina.
      </p>
    </header>

    <div class="locator" data-unit="macedo" data-reveal>
      <div class="locator__map">
        <div
          class="locator__map-canvas"
          data-map-canvas
          role="img"
          aria-label="Mapa com as unidades Kato Odontologia em Macedo e Cidade Maia, Guarulhos"
        ></div>
        <div class="locator__veil" aria-hidden="true"></div>
      </div>

      <aside class="locator__panel" aria-live="polite">
        <div class="unit-tabs" role="tablist" aria-label="Escolha uma unidade">
          {
            unidades.map((u) => (
              <button
                class="unit-tab"
                type="button"
                role="tab"
                data-unit-trigger={u.id}
                data-map-lat={mapLocations[u.id].lat}
                data-map-lng={mapLocations[u.id].lng}
                data-map-short={mapLocations[u.id].short}
                data-map-street={u.street}
                aria-selected={u.id === 'macedo' ? 'true' : 'false'}
              >
                <span>{u.n}</span>
                {mapLocations[u.id].short}
              </button>
            ))
          }
        </div>

        {
          unidades.map((u) => (
            <article class="unit-detail" data-unit-panel={u.id} hidden={u.id !== 'macedo'}>
              <div class="unit-detail__top">
                <h3>{u.name}</h3>
              </div>

              <address>
                {u.street}<br />
                {u.district} · {u.city}<br />
                São Paulo · SP
              </address>

              <div class="unit-detail__contacts" aria-label="Telefones da unidade">
                <a href={u.phoneHref}>
                  <Icon name="phone" size={18} />
                  {u.phone}
                </a>
                <a href={u.whatsappHref} target="_blank" rel="noopener">
                  <Icon name="whatsapp" size={18} />
                  {u.whatsapp}
                </a>
              </div>

              <div class="unit-detail__actions">
                <a class="btn btn--solid" href={u.whatsappHref} target="_blank" rel="noopener">
                  Agendar consulta <span class="btn__arrow" aria-hidden="true">→</span>
                </a>
                <a class="unit-detail__map-link" href={u.mapsHref} target="_blank" rel="noopener">
                  Traçar rota <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))
        }
      </aside>
    </div>
  </div>
</section>

<script>
  import L from 'leaflet';

  const locators = document.querySelectorAll<HTMLElement>('.locator');

  locators.forEach((locator) => {
    const triggers = locator.querySelectorAll<HTMLElement>('[data-unit-trigger]');
    const panels = locator.querySelectorAll<HTMLElement>('[data-unit-panel]');
    const mapCanvas = locator.querySelector<HTMLElement>('[data-map-canvas]');
    const mapTabs = locator.querySelectorAll<HTMLElement>('[role="tab"][data-map-lat][data-map-lng]');
    const markers = new Map<string, L.Marker>();

    const points = Array.from(mapTabs).map((tab) => {
      const id = tab.dataset.unitTrigger ?? '';
      return {
        id,
        lat: Number(tab.dataset.mapLat),
        lng: Number(tab.dataset.mapLng),
        short: tab.dataset.mapShort ?? '',
        street: tab.dataset.mapStreet ?? '',
      };
    }).filter((point) => point.id && Number.isFinite(point.lat) && Number.isFinite(point.lng));

    let map: L.Map | undefined;
    let bounds: L.LatLngBounds | undefined;

    if (mapCanvas && points.length) {
      map = L.map(mapCanvas, {
        zoomControl: false,
        attributionControl: true,
        dragging: false,
        scrollWheelZoom: false,
        doubleClickZoom: false,
        boxZoom: false,
        keyboard: false,
        touchZoom: false,
        zoomSnap: 0.25,
      });

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19,
      }).addTo(map);

      bounds = L.latLngBounds(points.map((point) => [point.lat, point.lng] as [number, number]));
      map.fitBounds(bounds, { padding: [72, 72], maxZoom: 14.75, animate: false });

      points.forEach((point) => {
        const icon = L.divIcon({
          className: 'kato-map-marker',
          html: '<span class="kato-map-marker__pin"><span></span></span>',
          iconSize: [46, 54],
          iconAnchor: [23, 48],
          tooltipAnchor: [0, -46],
        });

        const marker = L.marker([point.lat, point.lng], {
          icon,
          title: `Kato Odontologia · ${point.short}`,
          riseOnHover: true,
          keyboard: true,
        }).addTo(map!);

        marker.bindTooltip(
          `<strong>Kato · ${point.short}</strong><span>${point.street}</span>`,
          { className: 'kato-map-tooltip', direction: 'top', opacity: 1, offset: [0, -2] },
        );

        marker.on('click', () => activate(point.id));
        marker.on('mouseover', () => marker.openTooltip());
        marker.on('mouseout', () => {
          if (locator.dataset.unit !== point.id) marker.closeTooltip();
        });

        markers.set(point.id, marker);
      });

      const resizeObserver = new ResizeObserver(() => {
        if (!map || !bounds) return;
        map.invalidateSize({ pan: false });
        map.fitBounds(bounds, { padding: [72, 72], maxZoom: 14.75, animate: false });
      });
      resizeObserver.observe(mapCanvas);
    }

    const activate = (id: string) => {
      locator.dataset.unit = id;

      triggers.forEach((trigger) => {
        const active = trigger.dataset.unitTrigger === id;
        trigger.setAttribute('aria-pressed', String(active));
        if (trigger.getAttribute('role') === 'tab') trigger.setAttribute('aria-selected', String(active));
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.unitPanel !== id;
      });

      markers.forEach((marker, markerId) => {
        const active = markerId === id;
        marker.getElement()?.classList.toggle('is-active', active);
        if (active) marker.openTooltip();
        else marker.closeTooltip();
      });
    };

    triggers.forEach((trigger) => {
      const id = trigger.dataset.unitTrigger;
      if (!id) return;
      trigger.addEventListener('click', () => activate(id));
    });

    activate(locator.dataset.unit ?? 'macedo');
  });
</script>

<style>
  .unid {
    --surface: #f4fbfb;
    --surface-raised: #fff;
    --surface-inset: var(--aqua-100);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
    overflow: visible;
    padding-top: clamp(5rem, 8vw, 7.5rem);
    background:
      radial-gradient(circle at 8% 35%, rgb(190 245 246 / 0.55), transparent 30rem),
      radial-gradient(circle at 92% 82%, rgb(1 212 223 / 0.08), transparent 30rem),
      var(--surface);
  }

  .unid__head {
    display: grid;
    gap: var(--space-l);
    align-items: end;
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .unid__head h2 {
    max-width: 14ch;
    margin-top: var(--space-m);
    font-size: clamp(2.45rem, 4vw, 4rem);
  }

  .unid__intro {
    max-width: 43ch;
    color: var(--text-mid);
    line-height: 1.65;
  }

  .locator {
    display: grid;
    min-height: clamp(25rem, 32vw, 29rem);
    overflow: hidden;
    border: 1px solid rgb(1 212 223 / 0.26);
    border-radius: clamp(1.5rem, 3vw, 2.6rem);
    background: #fff;
    box-shadow: 0 2rem 4.5rem rgb(16 45 48 / 0.1);
  }

  .locator__map {
    position: relative;
    min-height: 23rem;
    overflow: hidden;
    background: #dce7e8;
    isolation: isolate;
  }

  .locator__map-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .locator__map-canvas :global(.leaflet-tile-pane) {
    filter: saturate(0.58) contrast(0.96) brightness(1.02) hue-rotate(132deg);
  }

  .locator__map-canvas :global(.leaflet-control-attribution) {
    padding: 0.2rem 0.45rem;
    background: rgb(255 255 255 / 0.82);
    color: rgb(16 45 48 / 0.66);
    font-size: 0.58rem;
    backdrop-filter: blur(8px);
  }

  .locator__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.05), transparent 48%, rgb(1 212 223 / 0.05)),
      linear-gradient(0deg, rgb(0 154 156 / 0.04), transparent 34%);
  }

  :global(.kato-map-marker) {
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  :global(.kato-map-marker__pin) {
    position: absolute;
    left: 50%;
    bottom: 0.35rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50% 50% 50% 0;
    background: linear-gradient(135deg, var(--aqua-300) 0%, var(--teal-500) 45%, var(--teal-700) 100%);
    box-shadow:
      0 0 0 0.22rem rgb(255 255 255 / 0.98),
      0.45rem 0.65rem 1.2rem rgb(0 154 156 / 0.34);
    transform: translateX(-50%) rotate(-45deg);
    transition: transform var(--dur-base) var(--ease-out), filter var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  :global(.kato-map-marker__pin > span) {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgb(5 42 48 / 0.08);
    transform: rotate(45deg);
  }

  :global(.kato-map-marker:focus-visible) {
    outline: 2px solid var(--teal-700);
    outline-offset: 0.3rem;
  }

  :global(.kato-map-marker:hover .kato-map-marker__pin),
  :global(.kato-map-marker.is-active .kato-map-marker__pin) {
    filter: saturate(1.16) brightness(1.08);
    box-shadow:
      0 0 0 0.22rem rgb(255 255 255 / 0.98),
      0 0 0 0.5rem rgb(1 212 223 / 0.18),
      0.45rem 0.65rem 1.2rem rgb(0 154 156 / 0.38);
    transform: translate(-50%, -0.16rem) rotate(-45deg) scale(1.1);
  }

  :global(.leaflet-tooltip.kato-map-tooltip) {
    display: grid;
    padding: 0.72rem 0.85rem;
    border: 1px solid rgb(1 212 223 / 0.28);
    border-radius: 0.78rem;
    background: rgb(255 255 255 / 0.96);
    box-shadow: 0 0.85rem 2rem rgb(16 45 48 / 0.14);
    color: var(--ink-1);
    min-width: 11.5rem;
    max-width: 14rem;
    text-align: left;
    white-space: normal;
    backdrop-filter: blur(12px);
  }

  :global(.leaflet-tooltip-top.kato-map-tooltip::before) {
    border-top-color: rgb(255 255 255 / 0.96);
  }

  :global(.kato-map-tooltip strong) {
    font-size: 0.9rem;
    line-height: 1.25;
    color: var(--teal-800);
  }

  :global(.kato-map-tooltip span) {
    margin-top: 0.16rem;
    font-size: 0.7rem;
    line-height: 1.35;
    color: rgb(16 45 48 / 0.62);
  }

  .locator__panel {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: clamp(1.1rem, 1.7vw, 1.5rem);
    background:
      radial-gradient(circle at 100% 0%, rgb(190 245 246 / 0.42), transparent 45%),
      #fff;
  }

  .unit-tabs {
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .unit-tab {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: -1px;
    padding: 0.35rem 0.1rem 0.75rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--text-low);
    font-size: 0.82rem;
    cursor: pointer;
    transition: border-color var(--dur-base) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .unit-tab span {
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .unit-tab[aria-selected='true'] {
    border-bottom-color: var(--teal-500);
    color: var(--teal-700);
  }

  .unit-detail {
    align-self: center;
    padding-block: clamp(1rem, 1.6vw, 1.4rem);
    animation: unit-in 500ms var(--ease-out) both;
  }

  .unit-detail h3 {
    font-size: clamp(1.8rem, 2.5vw, 2.55rem);
  }

  .unit-detail address {
    margin-top: 0.75rem;
    font-style: normal;
    line-height: 1.55;
    color: var(--text-mid);
  }

  .unit-detail__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.1rem;
    margin-top: 1.05rem;
  }

  .unit-detail__contacts a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: fit-content;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text-hi);
  }

  .unit-detail__contacts a:hover { color: var(--teal-700); }

  .unit-detail__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.15rem;
  }

  .unit-detail__map-link {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  @keyframes unit-in {
    from { opacity: 0; transform: translateY(0.7rem); }
    to { opacity: 1; transform: none; }
  }

  @media (width >= 56rem) {
    .unid__head {
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    }

    .locator {
      grid-template-columns: minmax(0, 1.62fr) minmax(19rem, 0.68fr);
    }
  }

  @media (width < 56rem) {
    .locator__map { min-height: clamp(21rem, 62vw, 26rem); }
    .locator__panel { min-height: 22rem; }
  }

  @media (width < 38rem) {
    .unid { padding-bottom: var(--space-xl); }
    .locator { border-radius: 1.35rem; }
    .locator__map { min-height: 20rem; }
    :global(.leaflet-tooltip.kato-map-tooltip) { min-width: 9.75rem; padding: 0.65rem 0.75rem; }
    .locator__panel { min-height: 23rem; }
    .unit-detail__actions { align-items: stretch; }
    .unit-detail__actions .btn { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .unit-detail { animation: none; }
  }
</style>
